# CronAgent Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# Required
# ============================================================

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================================
# Optional - GitHub Integration
# ============================================================

# GitHub personal access token (for GitHub skill)
GITHUB_TOKEN=ghp_...

# ============================================================
# Optional - Notifications
# ============================================================

# Slack incoming webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Discord webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ============================================================
# Optional - Channel Integrations
# ============================================================

# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC...

# Slack Bot tokens (for Slack channel, not just webhooks)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# Discord Bot token
DISCORD_BOT_TOKEN=...
DISCORD_APP_ID=...

# Webhook security
WEBHOOK_SECRET=your-secret-key-here

# ============================================================
# Optional - Production Database
# ============================================================

# PostgreSQL credentials (for production profile)
POSTGRES_USER=cronagent
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=cronagent

# ============================================================
# Optional - Monitoring
# ============================================================

# Grafana admin password
GRAFANA_PASSWORD=admin

# ============================================================
# Optional - Configuration
# ============================================================

# Timezone (default: UTC)
TZ=UTC

# CronAgent webhook port (default: 8080)
CRONAGENT_PORT=8080
